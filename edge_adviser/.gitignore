# Runtime data — regenerable from sources
workspace/
sessions/
__pycache__/
*.pyc

# Test scratch dirs (only a few fallback paths; pytest's tmp_path auto-cleans)
tests/_tmp_*

# Frontend build artifacts + deps (rebuilt via `cd webui && npm install && npm run build`)
webui/node_modules/
webui/dist/

# HMI per-asset runtime sidecar produced by the alert loop
workspace/**/alerts.jsonl

# Keep the reference workspace knowledge-assets if you want them versioned;
# remove the `workspace/` line above to track ASSET.md / MEMORY.md / reports.